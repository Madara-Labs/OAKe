{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OAKe Desktop",
  "version": "0.1.0",
  "identifier": "cc.madaralabs.oake",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:3410"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OAKe",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzRDVCRkJGNzNDOEMyNDcKUldSSHdzaHp2Ny9WVSttMU54NVVjSHNyK0swTmpxSWF0Lzh1bkt0b3Frcnl1dzhvNVo4d3p6T3oK",
      "endpoints": [
        "https://github.com/Madara-Labs/OAKe/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "category": "DeveloperTool",
    "shortDescription": "Local-first cryptographic provenance for research and code",
    "longDescription": "OAKe Desktop watches research directories, hashes artifacts locally, and anchors priority proofs to independent RFC 3161 TSAs and Bitcoin OpenTimestamps."
  }
}
